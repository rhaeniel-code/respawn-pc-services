rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // User profiles.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == "customer";
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
    }

    // Notification documents are private to their owner. Admins can create
    // customer status notifications and can access their own admin notifications.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == userId
        && (request.auth.uid == userId || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.type is string
        && request.resource.data.targetUrl is string
        && request.resource.data.read == false;

      allow update: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read is bool;

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Repair bookings.
    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.appointmentAt >= request.time + duration.value(24, "h")
        && !exists(/databases/$(database)/documents/bookingLocks/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId));

      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // One active booking per customer.
    match /bookingLocks/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == "Pending";

      allow delete, update: if isAdmin();
    }

    // Reserved appointment slots.
    match /bookingSlots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotId == slotId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == "Pending";

      allow update, delete: if isAdmin();
    }

    // Public store catalog. Only admins add/delete/edit; customer checkout can
    // decrease stock only as part of a matching order transaction.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.price == resource.data.price
        && request.resource.data.image == resource.data.image
        && request.resource.data.category == resource.data.category
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock", "lastOrderId", "stockUpdatedAt"])
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.lastOrderId is string
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)/items/$(productId)).data.productId == productId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)/items/$(productId)).data.quantity == resource.data.stock - request.resource.data.stock
      );
    }

    // Store orders.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderStatus == "Pending"
        && request.resource.data.paymentStatus == "Unpaid"
        && request.resource.data.itemCount >= 1
        && request.resource.data.total >= 0;

      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();

      match /items/{productId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin());

        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.orderStatus == "Pending"
          && request.resource.data.productId == productId
          && request.resource.data.quantity >= 1;

        allow update, delete: if isAdmin();
      }
    }
  }
}
